    "github": "text bound for GitHub (guard-gh-prose.py)",
    "deck": "slides (scripts/deck/lint.py)",
    "word": "Word docs (scripts/word-doc/lint.py)",
    "comment": "code comments (guard-comment-hygiene.sh, cleanup-comments)",
