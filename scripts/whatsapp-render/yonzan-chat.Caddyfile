# WhatsApp chat reader, served on the tailnet at /yonzan via `tailscale serve`.
{
	admin off
	auto_https off
}

http://:5119 {
	# localhost for `tailscale serve`, plus the Mac's tailnet IP so phones can use http://100.65.206.85:5119 without DNS
	bind 127.0.0.1 100.65.206.85
	root * "/Users/alcatraz627/Documents/WhatsApp Chat - yonzan"

	# The old Data Forge service worker re-checks /sw.js (proxied here) and gets a self-removing replacement.
	@kill path /_sw-kill.js
	header @kill Cache-Control "no-store"

	# chat.html is rebuilt in place, so make phones revalidate instead of using a stale copy
	@html path *.html /
	header @html Cache-Control "no-cache"

	# the bare address opens the chat
	rewrite / /chat.html

	encode zstd gzip
	file_server
}
