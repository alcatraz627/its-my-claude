def resolve(argv0):
    if os.path.isabs(argv0):
        return argv0 if os.path.exists(argv0) else None
    for d in os.environ.get("PATH", "").split(":"):
        p = os.path.join(d, argv0)
        if os.access(p, os.X_OK):
            return p
    return None


def verb_rows():
    rows = []
    for verb, group, argv, about in VERBS:
        target = "built in" if argv is None else (resolve(argv[0]) or "")
        rows.append({"verb": verb, "group": group, "about": about,
                     "runs": "built in" if argv is None else " ".join(argv),
                     "found": bool(target)})
    return rows


def cmd_list(as_json):
    rows = verb_rows()
    if as_json:
        print(json.dumps(rows, indent=2))
        return 0
    print(C.b("gcc") + C.d("  one front door to your own tools · gcc <verb> --help for each"))
    group = None
    for r in rows:
        if r["group"] != group:
            group = r["group"]
            print("\n" + C.y(group))
        mark = "" if r["found"] else C.r("  (not found)")
        print("  %s %s%s" % (C.c(r["verb"].ljust(14)), C.d(r["about"]), mark))
    print("\n" + C.d("gcc which <verb> · gcc agents · gcc tools · gcc --json"))
    return 0


def cmd_which(verb):
    for v, _, argv, _a in VERBS:
        if v == verb:
            print("built in" if argv is None else " ".join(argv))
            return 0
    die("no verb '%s'" % verb, 1, "gcc lists them")


def cmd_tools(as_json):
    rows = []
    try:
        with open(ZCMD_MANIFEST) as f:
            for line in f:
                if not line.strip() or line.startswith("#"):
                    continue
                parts = line.rstrip("\n").split("\t")
                rows.append({"name": parts[0], "kind": parts[1] if len(parts) > 1 else "",
                             "about": parts[-1] if len(parts) > 2 else ""})
    except OSError:
        die("zcmd manifest not found: " + ZCMD_MANIFEST, 1)
    if as_json:
        print(json.dumps(rows, indent=2))
        return 0
    print(C.y("Tools in zcmd's registry") + C.d("  (zcmd kit for the full cheatsheet)"))
    for r in rows:
        print("  %s %s" % (C.c(r["name"].ljust(16)), C.d(r["about"])))
    return 0


