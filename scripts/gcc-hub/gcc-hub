TIMED = ("daily", "weekly", "monthly", "one-shot")
OURS_PREFIXES = ("com.alcatraz", "dev.", "io.github.alcatraz627", "com.PM2")


def short_name(label):
    for p in ("com.alcatraz627.", "com.alcatraz.", "io.github.alcatraz627.", "dev.", "homebrew.mxcl.", "sh.brew.", "com."):
        if label.startswith(p):
            return label[len(p):]
    return label


def source_of(path):
    if not path:
        return "?"
    p = path.replace(HOME, "~")
    if p.startswith("~/.claude/"):
        return "gcc (" + p + ")"
    if p.startswith("~/Code/"):
        return p.split("/")[2] + " (" + p + ")"
    if p.startswith("/opt/homebrew/"):
        return "homebrew"
    if p.startswith("/Applications/") or "/Applications/" in p:
        return "app"
    return p


def human_cal(sci):
    if isinstance(sci, list):
        return ", ".join(human_cal(s) for s in sci)
    days = ["sun", "mon", "tue", "wed", "thu", "fri", "sat", "sun"]
    t = "%02d:%02d" % (sci.get("Hour", 0), sci.get("Minute", 0))
    if "Weekday" in sci:
        return "weekly %s %s" % (days[sci["Weekday"]], t)
    if "Day" in sci:
        return "monthly day %d %s" % (sci["Day"], t)
    return "daily " + t


def human_fire_at(kind, fire_at):
    parts = (fire_at or "").split("@")
    if kind == "daily":
        return "daily " + parts[-1]
    if kind == "weekly" and len(parts) == 3:
        return "weekly %s %s" % (parts[1], parts[2])
    if kind == "monthly" and len(parts) == 3:
        return "monthly %s %s" % (parts[1].replace("day", "day "), parts[2])
    return "once " + (fire_at or "?")


def launchd_state():
    loaded, disabled = set(), set()
    out = subprocess.run(["launchctl", "list"], capture_output=True, text=True).stdout
    for line in out.splitlines()[1:]:
        parts = line.split("\t")
        if len(parts) == 3:
            loaded.add(parts[2])
    out = subprocess.run(["launchctl", "print-disabled", "gui/%d" % UID], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if "=> disabled" in line:
            disabled.add(line.split('"')[1])
    return loaded, disabled


def last_runs():
    """Last recorded run per job, in local time."""
    last = {}
    try:
        with open(HISTORY) as f:
            for line in f:
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                if o.get("ev") == "run" and o.get("outcome") != "missed":
                    try:
                        t = (dt.datetime.strptime(o["ts"][:19], "%Y-%m-%dT%H:%M:%S")
                             .replace(tzinfo=dt.timezone.utc).astimezone().strftime("%a %d %b %H:%M"))
                    except (KeyError, ValueError):
                        t = o.get("ts", "?")
                    last[o.get("name")] = (t, o.get("outcome"))
    except OSError:
        pass
    return last


def cron_module():
    """gcc-cron's own code, so the hub agrees with the scheduler exactly."""
    path = os.path.join(S, "schedule", "gcc-cron")
    try:
        loader = importlib.machinery.SourceFileLoader("gcc_cron", path)
        spec = importlib.util.spec_from_loader("gcc_cron", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except Exception:
        return None


def next_runs(mod, registry):
    """Next fire per timed job within 32 days (covers monthly jobs)."""
    if not mod:
        return {}
    now = dt.datetime.now()
    return {n: t.strftime("%a %d %b %H:%M") for n, t in mod.due_jobs(registry, now, now + dt.timedelta(days=32))}


def cron_live(loaded):
    """True when gcc-cron is loaded and not in shadow mode, i.e. timers really run."""
    if "com.alcatraz.gcc-cron" not in loaded:
        return False
    try:
        with open(os.path.join(LAUNCHAGENTS, "com.alcatraz.gcc-cron.plist"), "rb") as f:
            return "--shadow" not in (plistlib.load(f).get("ProgramArguments") or [])
    except Exception:
        return False


def collect():
    """Every startup entry as one row: LaunchAgents plus gcc-cron's timed jobs."""
    meta = load_json(META, {})
    registry = load_json(REGISTRY, {})
    by_label = {j.get("label"): (n, j) for n, j in registry.items()}
    loaded, disabled = launchd_state()
    last = last_runs()
    mod = cron_module()
    nxt = next_runs(mod, registry)
    live = cron_live(loaded)
    rows = []
    for plist in sorted(glob.glob(os.path.join(LAUNCHAGENTS, "*.plist"))):
        try:
            with open(plist, "rb") as f:
                p = plistlib.load(f)
        except Exception:
            continue
        label = p.get("Label", os.path.basename(plist))
        argv = p.get("ProgramArguments") or [p.get("Program", "?")]
        if p.get("LaunchOnlyOnce"):
            cadence = "once at login"
        elif p.get("KeepAlive"):
            cadence = "always on"
        elif "StartInterval" in p:
            secs = p["StartInterval"]
            cadence = ("every %d min" % (secs // 60)) if secs < 3600 else ("every %g h" % (secs / 3600.0))
        elif "StartCalendarInterval" in p:
            cadence = human_cal(p["StartCalendarInterval"])
        elif p.get("RunAtLoad"):
            cadence = "once at login"
        else:
            cadence = "on demand"
        ours = label.startswith(OURS_PREFIXES) or argv[0].startswith((CL, os.path.join(HOME, "Code")))
        # The name is what macOS Login Items shows: the program's file name.
        name = os.path.basename(argv[0]) if argv[0] not in ("/bin/bash", "/bin/sh", "/usr/bin/python3") \
            else by_label.get(label, (short_name(label), None))[0]
        m = meta.get(label, {})
        rows.append({
            "name": name, "label": label, "title": m.get("title") or "", "note": m.get("note") or "",
            "kind": "service" if ours else "vendor", "cadence": cadence,
            "state": "off" if label in disabled else ("on" if label in loaded else "not loaded"),
            "login_item": os.path.basename(argv[0]), "program": " ".join(argv),
            "source": source_of(argv[0]), "plist": plist,
            "logs": [x for x in (p.get("StandardOutPath"), p.get("StandardErrorPath")) if x],
        })
    for name, job in sorted(registry.items()):
        if job.get("kind") not in TIMED:
            continue
        m = meta.get(job.get("label"), {})
        lr = last.get(name)
        argv = mod.job_argv(job) if (mod and job.get("adopted")) else None
        program = " ".join(argv) if argv else (job.get("command") or job.get("script") or "")
        src = argv[-1] if argv and len(argv) > 1 else job.get("script")
        state = "off" if job.get("enabled") is False else ("on" if live else "idle")
        rows.append({
            "name": name, "label": job.get("label"), "title": m.get("title") or (job.get("description") or "")[:70],
            "note": m.get("note") or "", "kind": "timer",
            "cadence": human_fire_at(job.get("kind"), job.get("fire_at")),
            "state": state,
            "login_item": "gcc-cron", "program": program,
            "source": source_of(src), "plist": job.get("plist"),
            "logs": [x for x in (job.get("out_log"), job.get("err_log")) if x],
            "last_run": ("%s %s" % lr) if lr else "", "next_run": nxt.get(name, ""),
            "description": job.get("description") or "",
        })
    return rows


def find(rows, name):
    hits = [r for r in rows if name in (r["name"], r["label"])]
    if not hits:
        die("no startup entry named '%s'" % name, 1, "gcc agents lists them")
    return hits[0]


STATE_COLOR = {"on": C.g, "off": C.r, "not loaded": C.d, "idle": C.y}   # idle: gcc-cron not running


def agents_list(rows, as_json):
    if as_json:
        print(json.dumps(rows, indent=2))
        return 0
    groups = [("Services (ours)", "service"), ("Timed jobs (run by gcc-cron)", "timer"), ("Vendor", "vendor")]
    for title, kind in groups:
        sub = [r for r in rows if r["kind"] == kind]
        if not sub:
            continue
        print(C.y("%s · %d" % (title, len(sub))))
        for r in sub:
            st = STATE_COLOR[r["state"]](r["state"].ljust(10))
            print("  %s %s %s %s" % (st, C.c(r["name"].ljust(26)), r["cadence"].ljust(22),
                                     r["title"] or C.d("(no title)")))
            if r["note"]:
                print("  " + " " * 38 + C.d("note: " + r["note"]))
        print()
    print(C.d("gcc agents show <name> · on|off <name> · title|note <name> \"text\" · --json"))
    return 0


def agents_show(r, as_json):
    if as_json:
        print(json.dumps(r, indent=2))
        return 0
    print(C.b(r["name"]) + "  " + STATE_COLOR[r["state"]](r["state"]))
    for k in ("title", "note", "kind", "cadence", "login_item", "source", "program", "plist",
              "last_run", "next_run", "description", "label"):
        if r.get(k):
            print("  %s %s" % (C.d(k.replace("_", " ").ljust(12)), r[k]))
    for lg in r.get("logs", []):
        print("  %s %s" % (C.d("log".ljust(12)), lg))
    return 0


def agents_toggle(r, on):
    if r["kind"] == "timer":
        sub = "enable" if on else "disable"
        return subprocess.run([os.path.join(S, "schedule", "schedule.sh"), sub, r["name"]]).returncode
    target = "gui/%d/%s" % (UID, r["label"])
    if on:
        subprocess.run(["launchctl", "enable", target])
        res = subprocess.run(["launchctl", "bootstrap", "gui/%d" % UID, r["plist"]], capture_output=True, text=True)
        if r["label"] not in launchd_state()[0]:
            die("could not load %s: %s" % (r["name"], res.stderr.strip() or "launchctl gave no reason"), 1)
        print("on: %s (loaded, stays on at login)" % r["name"])
    else:
        if r["label"] == "com.alcatraz.gcc-cron":
            print("note: gcc-cron starts every timed job; while it is off, none of them run", file=sys.stderr)
        subprocess.run(["launchctl", "bootout", target], capture_output=True)
        subprocess.run(["launchctl", "disable", target])
        print("off: %s (unloaded, stays off at login; gcc agents on %s to undo)" % (r["name"], r["name"]))
    return 0


def agents_meta(r, field, text):
    meta = load_json(META, {})
    meta.setdefault(r["label"], {})[field] = text
    tmp = META + ".tmp"
    with open(tmp, "w") as f:
        json.dump(meta, f, indent=2, sort_keys=True)
    os.replace(tmp, META)
    print("%s %s: %s" % (field, r["name"], text or "(cleared)"))
    return 0


def cmd_agents(args):
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    rows = collect()
    if not args or args[0] in ("list", "ls"):
        return agents_list(rows, as_json)
    sub, rest = args[0], args[1:]
    if sub in ("show", "on", "off", "title", "note") and not rest:
        die("usage: gcc agents %s <name>%s" % (sub, ' "text"' if sub in ("title", "note") else ""))
    if sub == "show":
        return agents_show(find(rows, rest[0]), as_json)
    if sub in ("on", "off"):
        return agents_toggle(find(rows, rest[0]), sub == "on")
    if sub in ("title", "note"):
        return agents_meta(find(rows, rest[0]), sub, " ".join(rest[1:]))
    die("unknown: gcc agents %s" % sub, 2, "gcc agents [list|show|on|off|title|note]")


HELP = """gcc-hub %s: one front door to your own tools

USAGE
  gcc                       grouped list of verbs
  gcc <verb> [args]         run that tool (its own --help applies)
  gcc which <verb>          what a verb runs
  gcc agents [...]          startup entries: list, show, on, off, title, note
  gcc tools                 everything in zcmd's registry

EXAMPLES
  gcc agents                # every startup entry with cadence and state
  gcc agents show gcc-cron  # program, plist, logs, last and next run
  gcc agents off residue-review
  gcc ipc peers             # same as claude-ipc peers
  gcc --json                # verbs as data

  Anything that is not a hub verb goes to the C compiler when called as gcc.
""" % VERSION


def main(argv):
    as_gcc = bool(argv) and argv[0] == "--as-gcc"
    if as_gcc:
        argv = argv[1:]
        if argv and argv[0] not in VERB_NAMES:   # gcc --help, gcc -o x x.c: the compiler's
            os.execv(REAL_GCC, [REAL_GCC] + argv)   # gcc -o x x.c and friends
    if not argv or argv[0] in ("--json",):
        return cmd_list("--json" in argv)
    verb, rest = argv[0], argv[1:]
    if verb in ("-h", "--help", "help"):
        print(HELP)
        return 0
    if verb in ("--version", "version"):
        print("gcc-hub " + VERSION)
        return 0
    if verb == "which":
        return cmd_which(rest[0]) if rest else die("usage: gcc which <verb>")
    if verb == "agents":
        return cmd_agents(rest)
    if verb == "tools":
        return cmd_tools("--json" in rest)
    for v, _, prefix, _a in VERBS:
        if v == verb and prefix:
            exe = resolve(prefix[0])
            if not exe:
                die("'%s' runs %s, which is not installed" % (verb, prefix[0]), 1)
            os.execv(exe, [exe] + prefix[1:] + rest)
    die("no verb '%s'" % verb, 2, "gcc lists them")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
