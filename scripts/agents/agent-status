#!/usr/bin/env python3
"""agent-status: which agents this session spawned are working, stuck, or finished, and did they deliver.

A parent that dispatched sub-agents or in-process teammates cannot tell "still
writing" from "dead" from "finished with nothing to show" by asking the harness
(TaskOutput says "No task found", ListAgents skips teammates). This reads the
one source that is always there, the agent transcripts under
~/.claude/projects/<project>/<session>/subagents/, and the output path each
dispatch named, and prints one row per agent.

States:
  RUNNING    transcript written within --stale seconds, last step not an end of turn
  STALLED    last step is not an end of turn and nothing written for --stale seconds
  DELIVERED  turn ended and the output file the dispatch named exists, is non-empty
             and is newer than the agent's first record
  EMPTY      turn ended and the named output file is missing, empty or older
  IDLE       turn ended and the dispatch named no output path, so nothing to verify

Usage:
  agent-status [NAME] [--session SID] [--project DIR] [--stale SECS] [--json]
  Exit 0 when nothing needs the parent; exit 1 when any agent is STALLED or EMPTY;
  exit 2 when the session has no subagents directory.

Environment: CLAUDE_CODE_SESSION_ID picks the session; AGENT_STATUS_PROJECTS
overrides ~/.claude/projects (the tests use it).
"""
import argparse
import datetime
import glob
import json
import os
import re
import sys
import time

TAIL_START = 256 * 1024
KEYWORDS = re.compile(r"output|write|persist|save|return", re.I)
PATH_RE = re.compile(r"(/[^\s'\"`,)<>]+\.(?:md|json|jsonl|txt|html|csv))")
SEAT_RE = re.compile(r"\boutput=(/\S+)")


def epoch(ts):
    try:
        return datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S.%fZ").replace(
            tzinfo=datetime.timezone.utc).timestamp()
    except (TypeError, ValueError):
        return None


def first_record(path):
    with open(path, "rb") as fh:
        line = fh.readline()
    return json.loads(line) if line.strip() else {}


def last_step(path):
    """Last user or assistant record. Attachments are bookkeeping, not progress."""
    size = os.path.getsize(path)
    span = TAIL_START
    while True:
        start = max(0, size - span)
        with open(path, "rb") as fh:
            fh.seek(start)
            chunk = fh.read()
        lines = chunk.split(b"\n")
        if start > 0:
            lines = lines[1:]  # first line may be cut in half
        for raw in reversed(lines):
            if not raw.strip():
                continue
            try:
                rec = json.loads(raw)
            except ValueError:
                continue
            if rec.get("type") in ("user", "assistant"):
                return rec
        if start == 0:
            return {}
        span *= 4


def prompt_text(rec):
    content = rec.get("message", {}).get("content", "")
    if isinstance(content, list):
        content = " ".join(b.get("text", "") for b in content if isinstance(b, dict))
    return content if isinstance(content, str) else ""


def output_path(text):
    """The file the dispatch told the agent to write, or None.

    A seat header carries output=PATH. Otherwise the last line that mentions
    writing or output and holds an absolute file path wins, because the
    delivery instruction is conventionally the final section of a brief.
    """
    m = SEAT_RE.search(text)
    if m:
        return m.group(1).rstrip(".")
    for line in reversed(text.splitlines()):
        if KEYWORDS.search(line):
            p = PATH_RE.search(line)
            if p:
                return p.group(1)
    return None


def delivered(path, since):
    if os.path.isdir(path):
        files = [os.path.join(path, f) for f in os.listdir(path)]
    else:
        files = [path]
    for f in files:
        try:
            st = os.stat(f)
        except OSError:
            continue
        if st.st_size > 0 and (since is None or st.st_mtime >= since):
            return True
    return False


def name_of(transcript, meta):
    base = os.path.basename(transcript)[len("agent-"):-len(".jsonl")]
    return meta.get("name") or meta.get("description") or meta.get("agentType") or base


def inspect(transcript, now, stale):
    meta = {}
    meta_path = transcript[:-len(".jsonl")] + ".meta.json"
    if os.path.exists(meta_path):
        try:
            meta = json.load(open(meta_path))
        except ValueError:
            pass
    first = first_record(transcript)
    last = last_step(transcript)
    started = epoch(first.get("timestamp"))
    age = now - os.path.getmtime(transcript)
    msg = last.get("message", {})
    ended = last.get("type") == "assistant" and msg.get("stop_reason") not in (None, "tool_use")
    out = output_path(prompt_text(first))
    if not ended:
        state = "STALLED" if age > stale else "RUNNING"
    elif out is None:
        state = "IDLE"
    else:
        state = "DELIVERED" if delivered(out, started) else "EMPTY"
    return {"name": name_of(transcript, meta), "state": state, "idle_secs": int(age),
            "output": out, "transcript": transcript}


def project_dir(args):
    root = os.environ.get("AGENT_STATUS_PROJECTS") or os.path.expanduser("~/.claude/projects")
    if args.project:
        return args.project
    return os.path.join(root, re.sub(r"[/.]", "-", os.getcwd()))


def human_age(secs):
    if secs < 90:
        return "%ds" % secs
    if secs < 5400:
        return "%dm" % (secs // 60)
    return "%dh" % (secs // 3600)


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("name", nargs="?")
    ap.add_argument("--session", default=os.environ.get("CLAUDE_CODE_SESSION_ID", ""))
    ap.add_argument("--project")
    ap.add_argument("--stale", type=int, default=300)
    ap.add_argument("--now", type=float, default=None, help=argparse.SUPPRESS)
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    proj = project_dir(args)
    if not args.session:
        dirs = [d for d in glob.glob(os.path.join(proj, "*", "subagents"))]
        if dirs:
            args.session = os.path.basename(os.path.dirname(max(dirs, key=os.path.getmtime)))
    sub = os.path.join(proj, args.session, "subagents")
    if not args.session or not os.path.isdir(sub):
        print("agent-status: no subagents directory for session %r under %s" % (args.session, proj), file=sys.stderr)
        return 2

    now = args.now if args.now is not None else time.time()
    rows = [inspect(t, now, args.stale) for t in sorted(glob.glob(os.path.join(sub, "agent-*.jsonl")))]
    if args.name:
        rows = [r for r in rows if args.name in r["name"]]

    if args.json:
        print(json.dumps(rows, indent=1))
    else:
        for r in rows:
            print("%-10s %-22s %5s  %s" % (r["state"], r["name"][:22], human_age(r["idle_secs"]), r["output"] or "-"))
        counts = {}
        for r in rows:
            counts[r["state"]] = counts.get(r["state"], 0) + 1
        print("%d agents: %s" % (len(rows), ", ".join("%d %s" % (n, s.lower()) for s, n in sorted(counts.items())) or "none"))
    return 1 if any(r["state"] in ("STALLED", "EMPTY") for r in rows) else 0


if __name__ == "__main__":
    sys.exit(main())
